local function createButton(text, color, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 32)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.LayoutOrder = order
    btn.Parent = scrollFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    return btn
end

-- ==========================================
-- 2. ระบบ ESP Coal (Auto-Scan)
-- ==========================================
local coalEspBtn = createButton("ESP Coal: OFF", Color3.fromRGB(80, 80, 90), 1)
local coalEspActive = false
local coalHighlights = {}

local function applyCoalHighlight(obj)
    if not obj:FindFirstChild("CoalHighlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "CoalHighlight"
        hl.FillColor = Color3.fromRGB(255, 200, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.4
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = obj
        hl.Parent = obj
        table.insert(coalHighlights, hl)
    end
end

local function clearCoalESP()
    for _, hl in pairs(coalHighlights) do
        if hl then hl:Destroy() end
    end
    coalHighlights = {}
end

coalEspBtn.MouseButton1Click:Connect(function()
    coalEspActive = not coalEspActive
    coalEspBtn.Text = coalEspActive and "ESP Coal: ON" or "ESP Coal: OFF"
    coalEspBtn.BackgroundColor3 = coalEspActive and Color3.fromRGB(200, 140, 0) or Color3.fromRGB(80, 80, 90)

    clearCoalESP()

    if coalEspActive then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == "Coal" and (obj:IsA("Model") or obj:IsA("BasePart")) then
                applyCoalHighlight(obj)
            end
        end
    end
end)

Workspace.DescendantAdded:Connect(function(descendant)
    if coalEspActive and descendant.Name == "Coal" then
        task.wait(0.1)
        if descendant:IsA("Model") or descendant:IsA("BasePart") then
            applyCoalHighlight(descendant)
        end
    end
end)

-- ==========================================
-- 3. ระบบ ESP ผู้เล่น (แก้ไขระบบใหม่ให้เสถียร 100%)
-- ==========================================
local playerEspBtn = createButton("ESP Player: OFF", Color3.fromRGB(80, 80, 90), 2)
local playerEspActive = false
local espStorage = {} -- เก็บข้อมูล ESP ของผู้เล่นแต่ละคน

local function clearESP(targetPlayer)
    if espStorage[targetPlayer] then
        if espStorage[targetPlayer].bg then espStorage[targetPlayer].bg:Destroy() end
        if espStorage[targetPlayer].hl then espStorage[targetPlayer].hl:Destroy() end
        espStorage[targetPlayer] = nil
    end
end

local function createESP(targetPlayer)
    if not targetPlayer.Character then return end
    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = targetPlayer.Character:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    local bg = Instance.new("BillboardGui")
    bg.Name = "PlayerESP_UI"
    bg.AlwaysOnTop = true
    bg.Size = UDim2.new(0, 200, 0, 60)
    bg.StudsOffset = Vector3.new(0, 3.5, 0)
    bg.Parent = hrp

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.RichText = true
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 11
    txt.TextStrokeTransparency = 0.2
    txt.Parent = bg

    local hl = Instance.new("Highlight")
    hl.Name = "PlayerESP_Chams"
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = targetPlayer.Character

    espStorage[targetPlayer] = {
        bg = bg,
        txt = txt,
        hl = hl,
        char = targetPlayer.Character,
        hrp = hrp,
        hum = hum
    }
end

-- ลูปกลางตัวเดียวสำหรับจัดการ ESP ของทุกคน
RunService.RenderStepped:Connect(function()
    if not playerEspActive then return end
    
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if targetPlayer == player then continue end
        
        local esp = espStorage[targetPlayer]
        
        -- ตรวจสอบว่าตัวละครยังอยู่หรือไม่ (ถ้าตาย/เพิ่งเกิดใหม่ ให้สร้าง ESP ใหม่)
        if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") or not targetPlayer.Character:FindFirstChild("Humanoid") then
            clearESP(targetPlayer)
            continue
        end
        
        local hrp = targetPlayer.Character.HumanoidRootPart
        local hum = targetPlayer.Character.Humanoid
        
        -- สร้าง ESP ใหม่ถ้าผู้เล่นเพิ่งเกิด
        if not esp or esp.char ~= targetPlayer.Character then
            clearESP(targetPlayer)
            createESP(targetPlayer)
            esp = espStorage[targetPlayer]
        end
        
        -- อัปเดตข้อมูล ESP (เลือด, ระยะทาง, สี)
        if esp and esp.bg and esp.hl then
            if hum.Health <= 0 then
                esp.bg.Enabled = false
                esp.hl.Enabled = false
                continue
            end

            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local myHrp = player.Character.HumanoidRootPart
                local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                
                local teamColor = targetPlayer.Team and targetPlayer.TeamColor.Color or Color3.fromRGB(255, 255, 255)
                local teamName = targetPlayer.Team and targetPlayer.Team.Name or "No Team"
                
                esp.hl.Enabled = true
                esp.hl.FillColor = teamColor
                esp.hl.OutlineColor = teamColor

                if dist > 2000 then
                    esp.bg.Enabled = false
                else
                    esp.bg.Enabled = true
                    esp.txt.Text = string.format(
                        "<font color='#FFFFFF'>%s</font>\n<font color='#%s'>%s</font>\n<font color='#FFFFFF'>Name: %s | Health: %d | Studs: %d</font>",
                        targetPlayer.Name, teamColor:ToHex(), teamName, targetPlayer.Name, math.floor(hum.Health), dist
                    )
                end
            end
        end
    end
end)

playerEspBtn.MouseButton1Click:Connect(function()
    playerEspActive = not playerEspActive
    playerEspBtn.Text = playerEspActive and "ESP Player: ON" or "ESP Player: OFF"
    playerEspBtn.BackgroundColor3 = playerEspActive and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(80, 80, 90)

    -- เมื่อกดปิด ล้าง ESP ทุกตัวทิ้งทันที
    if not playerEspActive then
        for _, p in pairs(Players:GetPlayers()) do
            clearESP(p)
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    clearESP(p) -- ล้างข้อมูลเมื่อผู้เล่นออกจากเซิร์ฟเวอร์
end)

-- ==========================================
-- 4. ระบบ Hitbox (แก้ไขให้ปิด-เปิดสมบูรณ์แบบ)
-- ==========================================
local hitboxBtn = createButton("Hitbox: OFF", Color3.fromRGB(80, 80, 90), 3)
local hitboxSizeBtn = createButton("ขนาด Hitbox: [10]", Color3.fromRGB(60, 60, 70), 4)
local hitboxTransBtn = createButton("ความใส: [50%]", Color3.fromRGB(60, 60, 70), 5)

local hitboxActive = false
local hitboxConnection = nil -- ตัวแปรเก็บลูปของ Hitbox

local sizes = {Vector3.new(10, 10, 10), Vector3.new(15, 15, 15), Vector3.new(20, 20, 20), Vector3.new(5, 5, 5)}
local currentHitboxSize = sizes[1]
local sizeIndex = 1

local transList = {0.5, 0.7, 0.9, 0.2}
local currentTrans = transList[1]
local transIndex = 1

local function resetHitboxSize()
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local hrp = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = Vector3.new(2, 2, 1) -- ขนาดตั้งต้นของ Roblox
                hrp.Transparency = 1
                hrp.CanCollide = false
            end
        end
    end
end

hitboxBtn.MouseButton1Click:Connect(function()
    hitboxActive = not hitboxActive
    hitboxBtn.Text = hitboxActive and "Hitbox: ON" or "Hitbox: OFF"
    hitboxBtn.BackgroundColor3 = hitboxActive and Color3.fromRGB(220, 50, 50) or Color3.fromRGB(80, 80, 90)

    if hitboxActive then
        -- เริ่มทำงาน Hitbox (สร้างลูป)
        if not hitboxConnection then
            hitboxConnection = RunService.Heartbeat:Connect(function()
                for _, otherPlayer in pairs(Players:GetPlayers()) do
                    if otherPlayer ~= player and otherPlayer.Character then
                        local hrp = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local teamColor = otherPlayer.Team and otherPlayer.TeamColor.Color or Color3.fromRGB(255, 255, 255)
                            hrp.Size = currentHitboxSize
                            hrp.Transparency = currentTrans
                            hrp.Color = teamColor
                            hrp.Material = Enum.Material.SmoothPlastic
                            hrp.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        -- ปิดการทำงาน (ตัดลูปทิ้ง และบังคับคืนค่าขนาด)
        if hitboxConnection then
            hitboxConnection:Disconnect()
            hitboxConnection = nil
        end
        resetHitboxSize()
    end
end)

hitboxSizeBtn.MouseButton1Click:Connect(function()
    sizeIndex = (sizeIndex % #sizes) + 1
    currentHitboxSize = sizes[sizeIndex]
    hitboxSizeBtn.Text = "ขนาด Hitbox: [" .. tostring(currentHitboxSize.X) .. "]"
end)

hitboxTransBtn.MouseButton1Click:Connect(function()
    transIndex = (transIndex % #transList) + 1
    currentTrans = transList[transIndex]
    hitboxTransBtn.Text = "ความใส: [" .. tostring(math.floor(currentTrans * 100)) .. "%]"
end)

-- ==========================================
-- 5. ระบบ Noclip
-- ==========================================
local noclipBtn = createButton("Noclip: OFF", Color3.fromRGB(80, 80, 90), 6)
local noclipActive = false
local noclipConnection = nil

local function enableNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    noclipConnection = RunService.Stepped:Connect(function()
        if player.Character then
            for _, child in pairs(player.Character:GetChildren()) do
                if child:IsA("BasePart") then
                    child.CanCollide = false
                end
            end
        end
    end)
end

local function disableNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    if player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end

        for _, child in pairs(player.Character:GetChildren()) do
            if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
                child.CanCollide = true
            end
        end
    end
end

noclipBtn.MouseButton1Click:Connect(function()
    noclipActive = not noclipActive
    noclipBtn.Text = noclipActive and "Noclip: ON" or "Noclip: OFF"
    noclipBtn.BackgroundColor3 = noclipActive and Color3.fromRGB(150, 0, 200) or Color3.fromRGB(80, 80, 90)

    if noclipActive then
        enableNoclip()
    else
        disableNoclip()
    end
end)

player.CharacterAdded:Connect(function()
    if noclipActive then
        noclipActive = false
        noclipBtn.Text = "Noclip: OFF"
        noclipBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end)

