-- 6. ระบบ Teleport
-- ==========================================
local function TeleportTo(x, y, z)
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if humanoidRootPart then
        humanoidRootPart.CFrame = CFrame.new(x, y, z)
    end
end

local tpBtn1 = createButton("SCP-914", Color3.fromRGB(0, 130, 255), 7)
local tpBtn5 = createButton("SCP-294", Color3.fromRGB(0, 130, 255), 8)
local tpBtn2 = createButton("ไปเอาเกราะ", Color3.fromRGB(0, 180, 100), 9)
local tpBtn3 = createButton("กลับไปที่ CD", Color3.fromRGB(200, 80, 80), 10)
local tpBtn4 = createButton("ไปซื้อปืน", Color3.fromRGB(220, 130, 30), 11)

local scp914Pos = Vector3.new(250, -34, 1671)
local checkRadius = 250

tpBtn1.MouseButton1Click:Connect(function()
    local canTeleport = true
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local char = otherPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local distance = (char.HumanoidRootPart.Position - scp914Pos).Magnitude
                if distance <= checkRadius then
                    canTeleport = false
                    break
                end
            end
        end
    end

    if canTeleport then
        TeleportTo(250, -34, 1671)
    else
        local originalText = tpBtn1.Text
        local originalColor = tpBtn1.BackgroundColor3
        tpBtn1.Text = "มีคนอยู่ใกล้! วาร์ปไม่ได้"
        tpBtn1.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        
        task.delay(1.5, function()
            tpBtn1.Text = originalText
            tpBtn1.BackgroundColor3 = originalColor
        end)
    end
end)

