local hitboxTransBtn = createButton("ความใส: [50%]", Color3.fromRGB(60, 60, 70), 5)

local hitboxActive = false
local sizes = {Vector3.new(10, 10, 10), Vector3.new(15, 15, 15), Vector3.new(20, 20, 20), Vector3.new(5, 5, 5)}
local currentHitboxSize = sizes[1]
local sizeIndex = 1

local transList = {0.5, 0.7, 0.9, 0.2}
local currentTrans = transList[1]
local transIndex = 1

hitboxBtn.MouseButton1Click:Connect(function()
    hitboxActive = not hitboxActive
