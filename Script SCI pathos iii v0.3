local function createButton(text, color, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 32)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.LayoutOrder = order
    btn.Parent = scrollFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    return btn
end

-- ==========================================
-- 2. ระบบ ESP Coal (Auto-Scan)
-- ==========================================
local coalEspBtn = createButton("ESP Coal: OFF", Color3.fromRGB(80, 80, 90), 1)
local coalEspActive = false
local coalHighlights = {}

local function applyCoalHighlight(obj)
    if not obj:FindFirstChild("CoalHighlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "CoalHighlight"
        hl.FillColor = Color3.fromRGB(255, 200, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.4
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = obj
        hl.Parent = obj
        table.insert(coalHighlights, hl)
    end
end

local function clearCoalESP()
    for _, hl in pairs(coalHighlights) do
        if hl then hl:Destroy() end
    end
    coalHighlights = {}
end

coalEspBtn.MouseButton1Click:Connect(function()
    coalEspActive = not coalEspActive
    coalEspBtn.Text = coalEspActive and "ESP Coal: ON" or "ESP Coal: OFF"
    coalEspBtn.BackgroundColor3 = coalEspActive and Color3.fromRGB(200, 140, 0) or Color3.fromRGB(80, 80, 90)

    clearCoalESP()

    if coalEspActive then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == "Coal" and (obj:IsA("Model") or obj:IsA("BasePart")) then
                applyCoalHighlight(obj)
            end
        end
    end
end)

Workspace.DescendantAdded:Connect(function(descendant)
    if coalEspActive and descendant.Name == "Coal" then
        task.wait(0.1)
        if descendant:IsA("Model") or descendant:IsA("BasePart") then
            applyCoalHighlight(descendant)
        end
    end
end)

-- ==========================================
-- 3. ระบบ ESP ผู้เล่น
-- ==========================================
local playerEspBtn = createButton("ESP Player: OFF", Color3.fromRGB(80, 80, 90), 2)
local playerEspActive = false

local function applyPlayerESP(targetPlayer)
    if targetPlayer == player then return end

    local function setupESP(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hrp or not hum then return end

        local bg = hrp:FindFirstChild("PlayerESP_UI") or Instance.new("BillboardGui")
        bg.Name = "PlayerESP_UI"
        bg.AlwaysOnTop = true
        bg.Size = UDim2.new(0, 200, 0, 60)
        bg.StudsOffset = Vector3.new(0, 3.5, 0)
        bg.Parent = hrp

        local txt = bg:FindFirstChild("TextLabel") or Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.RichText = true
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 11
        txt.TextStrokeTransparency = 0.2
        txt.Parent = bg

        local charHighlight = char:FindFirstChild("PlayerESP_Chams") or Instance.new("Highlight")
        charHighlight.Name = "PlayerESP_Chams"
        charHighlight.FillTransparency = 0.5
        charHighlight.OutlineTransparency = 0.1
        charHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        charHighlight.Parent = char

        local connection
        connection = RunService.RenderStepped:Connect(function()
            if not char:IsDescendantOf(Workspace) or not hum or hum.Health <= 0 then
                bg:Destroy()
                charHighlight:Destroy()
                if connection then connection:Disconnect() end
                return
            end

            if not playerEspActive then
                bg.Enabled = false
                charHighlight.Enabled = false
                return
            end

            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local myHrp = player.Character.HumanoidRootPart
                local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                
                local teamColor = targetPlayer.Team and targetPlayer.TeamColor.Color or Color3.fromRGB(255, 255, 255)
                local teamName = targetPlayer.Team and targetPlayer.Team.Name or "No Team"
                local hexColor = teamColor:ToHex()

                charHighlight.Enabled = true
                charHighlight.FillColor = teamColor
                charHighlight.OutlineColor = teamColor

                if dist > 2000 then
                    bg.Enabled = false
                else
                    bg.Enabled = true
                    txt.Text = string.format(
                        "<font color='#FFFFFF'>%s</font>\n<font color='#%s'>%s</font>\n<font color='#FFFFFF'>Name: %s | Health: %d | Studs: %d</font>",
                        targetPlayer.Name, hexColor, teamName, targetPlayer.Name, math.floor(hum.Health), dist
                    )
                end
            else
                bg.Enabled = false
                charHighlight.Enabled = false
            end
        end)
    end

    targetPlayer.CharacterAdded:Connect(setupESP)
    if targetPlayer.Character then setupESP(targetPlayer.Character) end
end

for _, p in pairs(Players:GetPlayers()) do
    applyPlayerESP(p)
end
Players.PlayerAdded:Connect(applyPlayerESP)

